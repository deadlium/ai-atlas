# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Default rules for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown files
[*.md]
trim_trailing_whitespace = false

# YAML & JSON files
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Python scripts (if used for validation/tooling)
[*.py]
indent_style = space
indent_size = 4
